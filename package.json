{
  "name": "block-clip",
  "displayName": "blockClip",
  "description": "%extension.description%",
  "version": "0.5.1",
  "publisher": "yuchuan",
  "l10n": "./l10n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/symudo/block-clip.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "copy-code-with-path.copySelection",
        "title": "%command.copySelection%"
      },
      {
        "command": "copy-code-with-path.copyCode",
        "title": "%command.copyCode%"
      },
      {
        "command": "copy-code-with-path.copyFolderCode",
        "title": "%command.copyFolderCode%"
      },
      {
        "command": "copy-code-with-path.addSelectionToStack",
        "title": "%command.addSelectionToStack%"
      },
      {
        "command": "copy-code-with-path.addToStack",
        "title": "%command.addToStack%"
      },
      {
        "command": "copy-code-with-path.copyStack",
        "title": "%command.copyStack%"
      },
      {
        "command": "copy-code-with-path.manageStack",
        "title": "%command.manageStack%"
      },
      {
        "command": "copy-code-with-path.popFromStack",
        "title": "%command.popFromStack%"
      },
      {
        "command": "copy-code-with-path.removeFromStack",
        "title": "%command.removeFromStack%"
      },
      {
        "command": "copy-code-with-path.clearStack",
        "title": "%command.clearStack%"
      }
    ],
    "keybindings": [
      {
        "command": "copy-code-with-path.copyCode",
        "key": "alt+shift+b",
        "when": "editorTextFocus"
      },
      {
        "command": "copy-code-with-path.addToStack",
        "key": "alt+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "copy-code-with-path.copyStack",
        "key": "alt+shift+x"
      }
    ],
    "submenus": [
      {
        "id": "copy-code-with-path.stackSubmenu",
        "label": "%submenu.clipStack%"
      }
    ],
    "menus": {
      "copy-code-with-path.stackSubmenu": [
        {
          "command": "copy-code-with-path.addSelectionToStack",
          "when": "editorTextFocus && editorHasSelection",
          "group": "1_action@0"
        },
        {
          "command": "copy-code-with-path.addToStack",
          "group": "1_action@1"
        },
        {
          "command": "copy-code-with-path.copyStack",
          "group": "1_action@2"
        },
        {
          "command": "copy-code-with-path.manageStack",
          "group": "2_manage@1"
        },
        {
          "command": "copy-code-with-path.popFromStack",
          "group": "2_manage@2"
        },
        {
          "command": "copy-code-with-path.removeFromStack",
          "group": "2_manage@3"
        },
        {
          "command": "copy-code-with-path.clearStack",
          "group": "3_clear@1"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceScheme == 'file' && !explorerResourceIsFolder",
          "command": "copy-code-with-path.copyCode",
          "group": "navigation@5"
        },
        {
          "when": "resourceScheme == 'file' && explorerResourceIsFolder",
          "command": "copy-code-with-path.copyFolderCode",
          "group": "navigation@5"
        },
        {
          "when": "!explorerResourceIsFolder && !resourceScheme && workspaceFolderCount > 0",
          "command": "copy-code-with-path.copyFolderCode",
          "group": "navigation@5"
        },
        {
          "when": "resourceScheme == 'file'",
          "submenu": "copy-code-with-path.stackSubmenu",
          "group": "navigation@6"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "command": "copy-code-with-path.copyCode",
          "group": "navigation@5"
        },
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "submenu": "copy-code-with-path.stackSubmenu",
          "group": "navigation@6"
        }
      ],
      "editor/context": [
        {
          "when": "(resourceScheme == 'file' || resourceScheme == 'untitled') && editorHasSelection",
          "command": "copy-code-with-path.copySelection",
          "group": "9_cutcopypaste@99"
        },
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "command": "copy-code-with-path.copyCode",
          "group": "9_cutcopypaste@100"
        },
        {
          "when": "resourceScheme == 'file' || resourceScheme == 'untitled'",
          "submenu": "copy-code-with-path.stackSubmenu",
          "group": "9_cutcopypaste@101"
        }
      ]
    },
    "configuration": {
      "title": "BlockClip",
      "properties": {
        "blockClip.maxContentSizeMB": {
          "type": "number",
          "default": 50,
          "minimum": 0,
          "description": "%config.maxContentSizeMB.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.js --production",
    "build": "node esbuild.config.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run check",
    "lint": "pnpm exec biome check",
    "test": "pnpm run compile && node --test out/test/*.test.js",
    "check": "pnpm exec biome check",
    "format": "pnpm exec biome format --write",
    "prepare": "simple-git-hooks",
    "change": "changeset",
    "version": "changeset version"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{js,ts,tsx,jsx,mjs,cjs}": "biome check --write",
    "*.{json,graphql,grit}": "biome format --write",
    "*.{css,scss}": "biome format --write",
    "*.html": "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^20.8.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.24.0",
    "lint-staged": "^16.1.6",
    "npm-run-all": "^4.1.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "ignore": "^7.0.5"
  }
}
