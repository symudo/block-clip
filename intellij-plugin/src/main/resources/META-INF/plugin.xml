<idea-plugin>
    <id>com.symudo.blockclip</id>
    <name>BlockClip</name>
    <vendor email="symudo@users.noreply.github.com" url="https://github.com/symudo/block-clip">symudo</vendor>

    <description><![CDATA[
    Copies file content with its relative path to the clipboard as beautifully formatted Markdown code blocks.<br>
    Features:
    <ul>
        <li>Copy single/multiple files or selected code directly from project view, editor tab, or editor context.</li>
        <li>Copy entire folder recursively in background with smart .gitignore & sensitive file filtering.</li>
        <li>Code Clip Stack: stash files, folders, and code snippets across project and copy all at once.</li>
        <li>Keyboard shortcuts (Alt+Shift+B / Alt+Shift+S / Alt+Shift+X) and size/token estimation.</li>
        <li>Dirty buffer first: copies latest unsaved changes from editor.</li>
        <li>Adaptive Markdown fences (prevents code block breakages).</li>
        <li>Full i18n support (English and Simplified Chinese).</li>
    </ul>
    ]]></description>

    <!-- 兼容所有基于 IntelliJ 平台的 IDE（IDEA, WebStorm, PyCharm, GoLand 等） -->
    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.BlockClipBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="BlockClip Notification"
                           displayType="BALLOON"
                           key="notification.group.name"/>
        <applicationConfigurable parentId="tools"
                                 instance="com.symudo.blockclip.BlockClipConfigurable"
                                 id="com.symudo.blockclip.settings"
                                 key="settings.display.name"
                                 bundle="messages.BlockClipBundle"/>
        <statusBarWidgetFactory id="com.symudo.blockclip.ClipStackStatusBarWidget"
                                implementation="com.symudo.blockclip.ClipStackStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <action id="com.symudo.blockclip.CopySelectionAction"
                class="com.symudo.blockclip.CopySelectionAction"
                text="Copy Selected Code"
                description="Copy selected code snippet with relative path and line range">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>

        <action id="com.symudo.blockclip.CopyCodeAction"
                class="com.symudo.blockclip.CopyCodeAction"
                text="Copy Code"
                description="Copy file content or selection with relative path">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="CutCopyPasteGroup"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="CopyPaths"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="com.symudo.blockclip.CopySelectionAction"/>
            <keyboard-shortcut keymap="$default" first-keystroke="alt shift B"/>
        </action>

        <action id="com.symudo.blockclip.CopyFolderCodeAction"
                class="com.symudo.blockclip.CopyFolderCodeAction"
                text="Copy Folder Code"
                description="Recursively copy folder contents with relative paths">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="com.symudo.blockclip.CopyCodeAction"/>
        </action>

        <group id="com.symudo.blockclip.ClipStackActionGroup"
               class="com.symudo.blockclip.ClipStackActionGroup"
               text="Clip Stack"
               popup="true">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="com.symudo.blockclip.CopyFolderCodeAction"/>
            <add-to-group group-id="EditorTabPopupMenu" anchor="after" relative-to-action="com.symudo.blockclip.CopyCodeAction"/>
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="com.symudo.blockclip.CopyCodeAction"/>

            <action id="com.symudo.blockclip.AddSelectionToStackAction"
                    class="com.symudo.blockclip.AddSelectionToStackAction"
                    text="Add Selection to Clip Stack"/>
            <action id="com.symudo.blockclip.AddToStackAction"
                    class="com.symudo.blockclip.AddToStackAction"
                    text="Add to Clip Stack">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift S"/>
            </action>
            <action id="com.symudo.blockclip.CopyStackAction"
                    class="com.symudo.blockclip.CopyStackAction"
                    text="Copy All in Clip Stack">
                <keyboard-shortcut keymap="$default" first-keystroke="alt shift X"/>
            </action>
            <separator/>
            <action id="com.symudo.blockclip.ManageStackAction"
                    class="com.symudo.blockclip.ManageStackAction"
                    text="Manage Clip Stack..."/>
            <action id="com.symudo.blockclip.PopStackAction"
                    class="com.symudo.blockclip.PopStackAction"
                    text="Pop Last Item"/>
            <action id="com.symudo.blockclip.RemoveFromStackAction"
                    class="com.symudo.blockclip.RemoveFromStackAction"
                    text="Remove Current File/Folder from Stack"/>
            <separator/>
            <action id="com.symudo.blockclip.ClearStackAction"
                    class="com.symudo.blockclip.ClearStackAction"
                    text="Clear Entire Clip Stack"/>
        </group>
    </actions>
</idea-plugin>
